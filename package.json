{
  "name": "nova",
  "version": "0.1.0",
  "description": "Lightweight AI notepad core — IntentService + EditorShell + FindBar.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/**/*.test.ts",
    "notepad": "tsx src/cli/notepad.ts",
    "notepad:demo": "tsx src/cli/notepad-demo.ts",
    "demo:ten-second": "tsx src/cli/ten-second-demo.ts",
    "demo:visual-ten-second": "tsx src/cli/visual-ten-second-demo.ts",
    "gates:windows": "tsx src/cli/windows-gates.ts",
    "ipc:host": "tsx src/ipc/cli-host.ts",
    "desktop:dev": "npm run build && npm --prefix desktop run tauri dev",
    "desktop:build": "npm run build && npm --prefix desktop run tauri build"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
